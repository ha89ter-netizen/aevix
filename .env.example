OPENAI_API_KEY=

# Строка подключения к Neon: Neon → Dashboard → Connection string (вариант "Pooled connection").
# Реальное значение кладётся в .env.local (он в .gitignore) и в Vercel → Settings →
# Environment Variables. В репозиторий пароль попадать не должен.
DATABASE_URL=

# Ключ подписи сессионных cookie. Сгенерировать своим значением:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Меняется — все выданные сессии перестают действовать, и это единственный способ разлогинить
# всех разом. На проде значение должно отличаться от локального.
AUTH_SECRET=

# ── Письма ───────────────────────────────────────────────────────────────────
# Через Resend уходят две разные вещи: заявки с лендинга и коды входа в аккаунт.
#
# Ключ Resend. Без него коды входа печатаются в консоль сервера вместо письма — рабочий режим
# для локальной разработки, но НЕ для прода: там без ключа войти в аккаунт невозможно.
RESEND_API_KEY=

# Куда падают заявки с формы на лендинге. ОБЯЗАТЕЛЬНА для прода: без неё (или без ключа выше)
# маршрут /api/lead отвечает 503, и человек видит честную ошибку отправки — молча терять заявку
# или слать её на захардкоженный адрес маршрут не станет.
#
# Это ПРИВАТНАЯ настройка, а не публичный контакт: адрес на сайте живёт в `contacts` и совпадать
# с этим не обязан.
#
# Может быть любым адресом: домен `aevix.org` в Resend настроен, поэтому письма уходят не с
# sandbox-отправителя и ограничения «только владельцу учётки» больше нет.
LEADS_TO_EMAIL=

# Отправитель ВСЕХ писем продукта — и заявки, и кода входа (имя переменной уже её смысла,
# см. `src/lib/mail.ts`).
#
# Задавать НЕ обязательно: по умолчанию `AEVIX <hello@aevix.org>` — адрес на своём домене.
# Нужен форку на другом домене или временной проверке отправки с чужой учётки Resend.
LEAD_EMAIL_FROM=

# ── Публичный адрес сайта ────────────────────────────────────────────────────
# Origin, от которого считаются canonical, og:url, robots.txt и sitemap.xml.
#
# Задавать НЕ обязательно: по умолчанию боевой домен `https://aevix.org`, и страница, собранная
# без этой переменной, отдаёт правильный canonical, а не адрес машины сборщика.
#
# Пригодится в двух случаях: превью-развёртывание, которому нужно ссылаться на себя, и переезд
# домена — тогда адрес меняется в одном месте, а не в четырёх файлах.
NEXT_PUBLIC_SITE_ORIGIN=
